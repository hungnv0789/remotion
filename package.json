{
  "name": "financial-liquidity-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "A Vietnamese 60-second portrait video about financial liquidity.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts FinancialLiquidity out/financial-liquidity.mp4 --codec=h264 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts FinancialLiquidity out/preview.png --frame=210"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.8",
    "@remotion/cli": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
