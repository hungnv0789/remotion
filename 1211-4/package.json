{
  "name": "nhnn-money-flow-1211-4",
  "version": "1.0.0",
  "private": true,
  "description": "Financial news motion graphics with generated Vietnamese narration",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "still": "remotion still src/index.ts MonetaryFlow1211 out/preview.png --frame=900",
    "render": "remotion render src/index.ts MonetaryFlow1211 out/1211-4.mp4 --codec=h264 --pixel-format=yuv420p --x264-preset=veryfast --concurrency=2",
    "captions": "tsx scripts/export-captions.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.8",
    "@remotion/cli": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}