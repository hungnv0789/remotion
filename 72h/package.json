{
  "name": "72h-emergency-news",
  "version": "1.0.0",
  "private": true,
  "description": "Vietnamese 72-hour preparedness news video with an aligned voiceover.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "still": "remotion still src/index.ts Emergency72Hours out/preview.png --frame=80",
    "render": "remotion render src/index.ts Emergency72Hours out/72h.mp4 --codec=h264 --pixel-format=yuv420p --x264-preset=veryfast --concurrency=2"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.8",
    "@remotion/cli": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
