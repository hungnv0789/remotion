{
  "name": "scb-zero-rate-1711",
  "version": "1.0.0",
  "private": true,
  "description": "Financial news motion graphics synchronized to the supplied 1711.mp3 audio",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "still": "remotion still src/index.ts SCBZeroRate1711 out/preview.png --frame=450",
    "render": "npm run captions && node scripts/render.mjs",
    "captions": "tsx scripts/export-captions.ts",
    "previews": "npm run captions && node scripts/render.mjs --stills",
    "captions:1811": "tsx scripts/1811/export-captions.ts",
    "render:1811": "npm run captions:1811 && node scripts/1811/render.mjs",
    "previews:1811": "npm run captions:1811 && node scripts/1811/render.mjs --stills"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.2.8",
    "@remotion/cli": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
