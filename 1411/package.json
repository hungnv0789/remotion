{
  "name": "bank-rate-pressure-1411",
  "version": "1.0.0",
  "private": true,
  "description": "Faceless financial news video with VieNeu-TTS female Northern voice",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "still": "remotion still src/index.ts BankRatePressure1411 out/preview.png --frame=450",
    "render": "npm run captions && node scripts/render.mjs",
    "captions": "tsx scripts/export-captions.ts",
    "previews": "npm run captions && node scripts/render.mjs --stills"
  },
  "dependencies": {
